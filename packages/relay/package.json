{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/relay",
  "version": "2.2.5",
  "description": "Hub and agent that expose remote opencode machines through a WebSocket tunnel",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/relay"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun test --only-failures"
  },
  "dependencies": {
    "effect": "catalog:",
    "jose": "6.0.11"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:"
  }
}
